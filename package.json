{
  "name": "@wuzhongyanqiu/dsh-plugins",
  "version": "0.1.0",
  "description": "Personal DeepSeek Harness plugin bundle with unified AI quota monitoring (Codex, Kimi, GLM Coding Plan, DeepSeek, 302.AI, OpenCode Go)",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "codex",
    "kimi",
    "deepseek",
    "opencode-go",
    "glm",
    "zai",
    "zhipu",
    "coding-plan",
    "balance",
    "usage",
    "quota"
  ],
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "main": "./index.js",
  "files": [
    "index.js",
    "client.js",
    "typert.host.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "PLUGINS.md",
    "NOTICE.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./typert": "./typert.host.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-credentials": "^0.1.0-rc.6"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "smoke": "node test-host.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-credentials": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.1",
    "react": "18.3.1"
  },
  "author": "wuzhongyanqiu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wuzhongyanqiu/dsh-plugins.git"
  },
  "bugs": {
    "url": "https://github.com/wuzhongyanqiu/dsh-plugins/issues"
  },
  "homepage": "https://github.com/wuzhongyanqiu/dsh-plugins#readme"
}
